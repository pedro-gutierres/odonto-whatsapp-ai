{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "odonto-whatsapp-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "observability": { "enabled": true },

  // Assets estáticos públicos (JS modular do painel /inbox)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Valores que NÃO são secretos (pode ficar no GitHub)
  "vars": {
    "OPERATIONAL_TRIAL_ENABLED": "false",
    "GRAPH_VERSION": "v26.0",
    "CLAUDE_MODEL": "claude-haiku-5-5",
    "CLAUDE_EFFORT": "low",
    "SUPERADMIN_EMAILS": "pedrogutierres@protonmail.com"
  },

  // Banco de dados. Cole o ID que o comando "wrangler d1 create" mostrar.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "odonto-db",
      "database_id": "cf30eb94-4608-4134-af84-45af68e44482"
    }
  ],

  // Armazenamento de mídias (áudios e fotos por 30 dias)
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "odonto-media"
    }
  ],

  // Workers AI (transcrição de áudio com Whisper na borda)
  "ai": {
    "binding": "AI"
  },

  // Fila: o webhook coloca mensagens aqui; o mesmo Worker as processa depois.
  "queues": {
    "producers": [{ "binding": "INBOX", "queue": "odonto-inbox" }],
    "consumers": [
      {
        "queue": "odonto-inbox",
        "max_batch_size": 5,
        "max_batch_timeout": 2,
        "max_retries": 4,
        "dead_letter_queue": "odonto-inbox-dlq"
      }
    ]
  },

  // Agendador: executa confirmações automáticas às 20h de Brasília (23:00 UTC)
  "triggers": {
    "crons": ["* * * * *", "0 23 * * *"]
  }
}
