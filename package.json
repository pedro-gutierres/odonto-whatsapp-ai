{
  "name": "odonto-whatsapp-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:clinic && npm run test:operations && npm run test:support && npm run test:frontend",
    "test:clinic": "esbuild tests/clinic-whatsapp.test.ts --bundle --platform=node --format=esm --outfile=.wrangler/tmp/clinic-whatsapp.test.mjs && node --test .wrangler/tmp/clinic-whatsapp.test.mjs",
    "test:operations": "esbuild tests/operations-billing.test.ts --bundle --platform=node --format=esm --outfile=.wrangler/tmp/operations-billing.test.mjs && node --test .wrangler/tmp/operations-billing.test.mjs",
    "test:support": "esbuild tests/support-ai.test.ts --bundle --platform=node --format=esm --outfile=.wrangler/tmp/support-ai.test.mjs && node --test .wrangler/tmp/support-ai.test.mjs",
    "logs": "wrangler tail",
    "db:migrate:remote": "wrangler d1 migrations apply odonto-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply odonto-db --local",
    "test:frontend": "esbuild tests/frontend-ui.test.ts --bundle --packages=external --platform=node --format=esm --outfile=.wrangler/tmp/frontend-ui.test.mjs && node --test .wrangler/tmp/frontend-ui.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "happy-dom": "21.0.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.0"
  }
}
