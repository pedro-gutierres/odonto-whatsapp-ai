# Copie este arquivo para ".dev.vars" (sem .example) para testar no seu computador.
# NUNCA suba o .dev.vars para o GitHub (ele já está no .gitignore).
META_APP_SECRETS=cole_o_app_secret_do_app_lab
WA_VERIFY_TOKEN=invente_uma_frase_longa_e_aleatoria
ANTHROPIC_API_KEY=sk-ant-...
WA_LAB_TOKEN=cole_o_token_da_meta

# Integrações opcionais: permanecem desabilitadas sem configuração.
# Produção: Cloudflare > Worker > Settings > Variables and Secrets.
# Guia completo: REESTRUTURACAO.md. Não envie secrets pelo chat.
OPERATIONAL_TRIAL_ENABLED=true
# META_APP_ID=seu_app_id_meta
# META_EMBEDDED_CONFIG_ID=sua_configuracao_embedded_signup
# META_APP_SECRET=secret_do_mesmo_aplicativo_meta
PADDLE_ENABLED=false
PADDLE_ENVIRONMENT=sandbox
PADDLE_SANDBOX_ENTITLEMENTS=false
# PADDLE_API_KEY=chave_privada_da_sandbox
# PADDLE_CLIENT_TOKEN=token_publico_da_sandbox
# PADDLE_WEBHOOK_SECRET=secret_do_destino_de_notificacoes
# PADDLE_MONTHLY_PRICE_ID=pri_preco_mensal_brl_19900
# PADDLE_YEARLY_PRICE_ID=pri_preco_anual_brl_214800
